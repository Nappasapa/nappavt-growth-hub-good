# Growth Hub backend environment — copy to `.env` (gitignored, never commit).
# The frontend NEVER sees any of this; the browser only talks HTTP to the API.

# --- HTTP server ---
HOST=0.0.0.0
PORT=8788
# Public origin of the deployment (for the same-origin mutation guard).
# Example: APP_ORIGIN=https://hub.example.com  (leave empty when unsure)
APP_ORIGIN=

# --- MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=growthhub
DB_PASSWORD=change-me-strange-me
DB_NAME=growthhub
# Root password — used by docker-compose to initialize the database container only.
DB_ROOT_PASSWORD=change-me-root
DB_CONNECTION_LIMIT=8
# DB_SSL=1            # enable when the DB requires TLS (e.g. managed MariaDB)

# --- Sessions ---
# Recommended: a long random value. Signs session cookies so forged/foreign
# cookies are rejected without even hitting the database.
SESSION_SECRET=change-me-to-64-random-hex
SESSION_DAYS=14
# Set 0 ONLY for plain-http local development (sessions need Secure cookies off).
SECURE_COOKIES=1

# --- Owner bootstrap (first run only, or use `npm run user:create`) ---
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-please-12chars

# --- Bot (Nappa Bot on Craftnode) ---
BOT_SYNC_TOKEN=generate-a-long-random-token-here

# --- Storage (clip object store; metadata lives in MariaDB, bytes here) ---
STORAGE_DRIVER=local
STORAGE_DIR=data/clips

# --- Limits / scheduler ---
MAX_UPLOAD_BYTES=2147483648
SCHEDULER_INTERVAL_MS=900000
ENABLE_SCHEDULER=1
# AUTO_MIGRATE=1      # default: run pending migrations at boot
